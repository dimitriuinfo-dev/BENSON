<?xml version="1.0" encoding="utf-8"?>
<!--
  Narrowed to typeWindowStateChanged only (2026-07-09): the previous full set
  (+typeWindowContentChanged/typeViewClicked/typeViewFocused/typeViewTextChanged) fires on
  every UI change system-wide, in every app, not just BENSON's own screens; confirmed via
  live device testing to be the dominant cause of a severe CPU/thermal spike (75-105% CPU,
  ~90C) once the service was actually enabled. Still narrow as of 2026-07-14: placeWhatsAppCall
  polls rootInActiveWindow directly via delay()-based loops (waitForNode), it does not depend on
  typeWindowContentChanged events firing, so this stays untouched. Re-widen only if a feature
  that genuinely needs reactive content-change events is wired in, and the cost re-measured.

  canRetrieveWindowContent re-enabled 2026-07-14 (product-owner authorized) for the native
  WhatsApp call-flow state machine (BensonAccessibilityService.placeWhatsAppCall) — it cannot
  function with this off, since rootInActiveWindow unconditionally returns null without it,
  which is exactly what blocked every attempt before this. canPerformGestures deliberately left
  false: placeWhatsAppCall only ever calls AccessibilityNodeInfo.performAction() (ACTION_CLICK /
  ACTION_SET_TEXT) on specific verified nodes, never dispatchGesture()-style synthetic gestures,
  so it doesn't need that capability. This is a narrower request than the
  canRetrieveWindowContent+canPerformGestures combination that was confirmed (2026-07-09) to
  trigger ColorOS's spyware heuristic and auto-disable the service on this device — if ColorOS
  still disables the service with only this one flag on, that combination isn't the sole
  trigger and this needs revisiting.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:canRequestFilterKeyEvents="false"
    android:canRequestTouchExplorationMode="false"
    android:notificationTimeout="150"
    android:description="@string/benson_accessibility_description" />
